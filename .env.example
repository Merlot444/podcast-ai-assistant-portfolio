# Copy this file to .env later and fill values locally.
# Never commit the real .env file.
# app.api does not load .env automatically. Export it explicitly in your local shell.
# Relative SQLite paths are resolved from the project root, not the current directory.
DATABASE_URL=sqlite+pysqlite:///data/podcast-ai-assistant.sqlite3
# Optional PostgreSQL (install the postgres extra); keep credentials only in local .env:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Day 26 API process settings. These values keep the service local by default.
PODCAST_API_HOST=127.0.0.1
PODCAST_API_PORT=8000
PODCAST_MAX_REQUEST_BODY_BYTES=16384
# Required in agent mode. Generate a random value and send it as Bearer auth.
PODCAST_API_BEARER_TOKEN=

# Day 27 safe default. Leave Agent-only fields empty while unavailable is selected.
PODCAST_ASK_MODE=unavailable
PODCAST_ASK_EPISODE_ID=
PODCAST_ASK_TRANSCRIPT_PATH=
PODCAST_ASK_INDEX_DIRECTORY=

# Day 27 Agent model provider. Never place a real key in this tracked template.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30

# Day 27 Vector query provider. It reloads an existing matching index; it does
# not rebuild document Embeddings during Ask startup or request handling.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIMENSION=1024
EMBEDDING_DOCUMENT_TASK=retrieval.passage
EMBEDDING_QUERY_TASK=retrieval.query
EMBEDDING_TYPE=float
EMBEDDING_NORMALIZED=true
EMBEDDING_TRUNCATE=false
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30

# Optional: Day 15 uses this when set, otherwise it reuses EMBEDDING_API_KEY.
RERANK_API_KEY=
